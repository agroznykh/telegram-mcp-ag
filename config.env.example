# Конфигурация telegram-mcp-ag.
#
# Обычно этот файл создаёт install.sh в ~/telegram-mcp-ag/config.env —
# руками редактировать нужно, только если ставите сервер вручную или
# чините доступ. Права файла должны быть 600 (chmod 600 config.env):
# здесь лежит доступ к вашему Telegram-аккаунту.

# api_id и api_hash — с my.telegram.org/apps, раздел "API development tools".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Строка сессии — появляется после входа в Telegram (QR-код или телефон+код).
# Одна строка сессии — одна машина: если её скопировать на вторую машину,
# Telegram завершит обе сессии ошибкой AUTH_KEY_DUPLICATED. Для второй
# машины нужен отдельный вход, а не копирование этого значения.
TELEGRAM_SESSION_STRING=

# read-only запрещает серверу отправлять сообщения и менять данные аккаунта.
# Не снимайте это ограничение без явной необходимости.
#
# Чтобы ассистент мог ещё и сохранять файлы из сообщений (голосовые, кружки,
# видео, фото, документы) на диск вашего компьютера, замените значение на
#   TELEGRAM_EXPOSED_TOOLS=read-only+download_media
# В Telegram это ничего не меняет, но инструмент пишет файлы на ваш диск, а
# установщик заранее одобряет вызовы инструментов сервера: проверьте, что
# понимаете, что включаете.
TELEGRAM_EXPOSED_TOOLS=read-only

# Куда ложатся скачанные файлы (нужно только при read-only+download_media).
# Если клиент (например, Claude Code) сообщает папку проекта, файл попадает в
# <проект>/Telegram/. Ключи ниже нужны, когда клиент папку не сообщает.
#
# Запасная папка: абсолютный путь. Примеры:
#   macOS:   /Users/имя/Downloads/Telegram
#   Windows: C:\Users\имя\Downloads\Telegram
#   Linux:   /home/имя/Загрузки/Telegram
# TELEGRAM_ALLOWED_ROOTS=/Users/имя/Downloads/Telegram
# 1 = использовать запасную папку, даже если клиент прислал пустой список
# папок или не ответил за 10 секунд.
# TELEGRAM_ALLOW_SERVER_ROOTS_FALLBACK=1
# Имя подпапки внутри папки проекта: <проект>/Telegram/.
# TELEGRAM_DOWNLOAD_SUBDIR=Telegram

# Имя, под которым сессия видна в Telegram -> Settings -> Devices.
TELEGRAM_DEVICE_MODEL=Telegram MCP AG
